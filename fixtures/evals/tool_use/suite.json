{
  "name": "tool_use",
  "description": "Correct tool selection and usage",
  "version": "1.0.0",
  "cases": [
    {
      "id": "tool-use-001",
      "name": "Use balance_check tool for account balance query",
      "category": "tool_use",
      "input": {
        "prompt": "What is the DOT balance of account 5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY?",
        "context": {},
        "tools_available": ["balance_check", "chain_query", "memory_search"]
      },
      "expected": {
        "must_contain": [],
        "must_not_contain": [],
        "expected_tool_calls": [
          {
            "tool_name": "balance_check",
            "args_contain": {
              "address": "5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY"
            }
          }
        ],
        "expected_outcome": "success",
        "custom_scorer": null
      },
      "tags": ["tool-use", "balance"],
      "timeout_secs": 30
    },
    {
